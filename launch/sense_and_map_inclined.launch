<!-- sense_and_map_inclined.launch -->
<launch>

  <!-- 
    This launch file sets up SLAM (Simultaneous Localization and Mapping) using
    gmapping with the RPLidar sensor. The LIDAR data is processed with incline
    compensation to account for uneven terrain, ensuring accurate map generation
    even when the robot is traversing inclined surfaces.
  -->

  <!-- Specify the package name -->
  <arg name="package" default="mattbot_bringup"/>

  <!-- Launch a node from the package -->
  <node pkg="$(arg package)" type="mcu_comms.py" name="mcu_comms_node" output="screen">
    <!-- Add any additional node-specific parameters here -->
  </node>

  <!-- Launch the twist multiplexer -->
  <include file="$(find twist_mux)/launch/twist_mux.launch">
    <arg name="output_loc" value="log"/>
  </include>
  
  <!-- Launch the LIDAR -->
  <include file="$(find rplidar_ros)/launch/rplidar_a2m12.launch">
    <arg name="scan_topic" value="scan_original"/>
  </include>

  <!-- Launch LiDAR Correction -->
  <include file="$(find mattbot_mcl)/launch/lidar_correction.launch">
    <arg name="scan_input" value="/scan_original"/>
    <arg name="scan_output" value="/scan"/>  
  </include>

  <!-- Launch the Camera -->
  <include file="$(find astra_camera)/launch/astra.launch">
  
  </include>
  
  <!-- Launch SLAM -->
  <include file="$(find gmapping)/launch/slam_gmapping_pr2.launch">
      <arg name="output_location" value="log"/>
  </include>

</launch>
