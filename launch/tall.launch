<!-- tall.launch -->
<!-- Full stack for the tall robot. Override args at launch, e.g. capture:=true audio:=true -->
<launch>

  <!-- Robot / hardware -->
  <arg name="tall" default="true"/>              <!-- Tall form factor: OSOD model, nav map, MCL tuning -->
  <arg name="car" default="false"/>              <!-- Car platform: inclined LiDAR correction + amcl_car -->
  <arg name="camera_type" default="$(env CAMERA_TYPE)"/>  <!-- astra_pro_plus or astra (depth camera launch) -->

  <!-- Navigation -->
  <arg name="patrol" default="false"/>           <!-- Enable patrol waypoint loop in navigator -->
  <arg name="enable_depth_occupancy_grid" default="false"/>  <!-- Camera depth occupancy grid in occupancy_grid_mapper (CPU-heavy) -->
  <arg name="enable_object_blockout" default="true"/>       <!-- Block /object_map cells when cones are confirmed -->
  <arg name="max_object_blockout_width" default="0.5"/>    <!-- Max side length (m) of each object blockout on /object_map -->
  <arg name="object_blockout_ttl_sec" default="30.0"/>     <!-- 0 = no expiry; remove expired blockouts only in IDLE -->
  <arg name="robot_clearance" default="0.4"/>    <!-- Planning radius from robot center (m); ~robot_clearance -->
  <arg name="cruising_velocity" default="0.40"/> <!-- Nominal path speed (m/s); published as /cruising_velocity -->
  <arg name="max_plan_time_sec" default="15.0"/> <!-- Max wall-clock time (s) for A* path planning -->
  <param name="cruising_velocity" value="$(arg cruising_velocity)"/>
  <param name="enable_depth_occupancy_grid" value="$(arg enable_depth_occupancy_grid)"/>
  <param name="enable_object_blockout" value="$(arg enable_object_blockout)"/>
  <param name="max_object_blockout_width" value="$(arg max_object_blockout_width)"/>
  <param name="object_blockout_ttl_sec" value="$(arg object_blockout_ttl_sec)"/>

  <!-- Perception -->
  <arg name="use_llm_for_images" default="false"/>  <!-- Send unknown-object crops to gemini_bridge for labeling -->
  <arg name="face_detection" default="false"/>      <!-- Launch face_detection node (needs camera) -->

  <!-- Data capture (images + optional wakeword audio upload) -->
  <arg name="capture" default="false"/>            <!-- mattbot_capture: capture_node, uploader, auto_trigger; capture:=true also enables camera IR -->
  <arg name="capture_spool_dir" default="/workspace/catkin_ws/data/capture_spool"/>  <!-- Local spool (images + audio sessions) -->
  <arg name="capture_ingest_ip" default="192.168.50.2"/>   <!-- Central ingest host for capture_uploader -->
  <arg name="capture_ingest_port" default="8080"/>         <!-- Central ingest port (/api/v1/upload) -->
  <arg name="pose_spool_dir" default="/workspace/catkin_ws/data/pose_spool"/>  <!-- Local spool for pose chunks -->
  <arg name="detection_spool_dir" default="/workspace/catkin_ws/data/detection_spool"/>  <!-- Local spool for detection snapshots -->

  <!-- Audio (I2S mic, wakeword, Whisper, voice goals) -->
  <arg name="audio" default="false"/>              <!-- Launch mattbot_record audio_with_speech_detection -->
  <arg name="save_wakeword_audio" default="false"/>  <!-- Save post-wakeword WAVs to capture_spool_dir (needs ROBOT_ID; upload needs capture:=true) -->

  <!-- Fleet / logging -->
  <arg name="sqlite" default="false"/>             <!-- Persist DDS traffic to SQLite via mattbot_dds -->

  <arg name="package" default="mattbot_bringup"/>

  <include file="$(find mattbot_bringup)/launch/minimal.launch">
    <arg name="car" value="$(arg car)"/>
    <arg name="tall" value="$(arg tall)"/>
  </include>

  <!-- Conditionally launch LiDAR Correction based on car parameter -->
  <group if="$(arg car)">
    <!-- Launch the LIDAR -->
    <include file="$(find rplidar_ros)/launch/rplidar_a2m12.launch">
      <arg name="scan_topic" value="scan_original"/>
    </include>

    <!-- Launch LiDAR Correction with inclined compensation -->
    <include file="$(find mattbot_mcl)/launch/lidar_correction.launch">
      <arg name="scan_input" value="/scan_original"/>
      <arg name="scan_output" value="/scan"/>  
    </include>

    <!-- Launch AMCL for the car -->
    <include file="$(find mattbot_bringup)/launch/amcl_car.launch">
      <!-- No arguments needed -->
    </include>
  </group>
  
  <group unless="$(arg car)">
    <!-- Launch the LIDAR without inclined correction -->
    <include file="$(find rplidar_ros)/launch/rplidar_a2m12.launch">
      <!-- No arguments needed -->
    </include>

    <!-- Launch AMCL for the robot -->
    <include file="$(find mattbot_bringup)/launch/amcl.launch">
      <!-- No arguments needed -->
    </include>
  </group>

  <include file="$(find mattbot_mcl)/launch/localization_quality.launch">
    <arg name="tall" default="$(arg tall)"/>
  </include>
  
  <!-- Launch the Camera -->
  <group if="$(eval arg('camera_type') == 'astra_pro_plus')">
    <!-- Launch the astra pro plus camera-->
    <include file="$(find astra_camera)/launch/astra_pro_plus.launch">
      <arg name="enable_ir" value="$(arg capture)"/>
    </include>
  </group>

  <group unless="$(eval arg('camera_type') == 'astra_pro_plus')">
    <!-- If not astra_pro_plus, default to astra -->
    <include file="$(find astra_camera)/launch/astra.launch">
      <arg name="enable_ir" value="$(arg capture)"/>
    </include>
  </group>

  <!-- Launch the OSOD -->
  <include file="$(find mattbot_image_detection)/launch/detect_updated_osod.launch">
    <arg name="tall" default="$(arg tall)"/>
    <arg name="use_llm_for_images" value="$(arg use_llm_for_images)"/>
  </include> 

  <include file="$(find mattbot_navigation)/launch/localize_and_navigate_combined_map_tall.launch">
    <arg name="patrol" value="$(arg patrol)"/>
    <arg name="tall"   value="$(arg tall)"/>
    <arg name="car"    value="$(arg car)"/>
    <arg name="robot_clearance" value="$(arg robot_clearance)"/>
    <arg name="cruising_velocity" value="$(arg cruising_velocity)"/>
    <arg name="max_plan_time_sec" value="$(arg max_plan_time_sec)"/>
  </include>

  <include file="$(find mattbot_dds)/launch/dds.launch">
    <arg name="sqlite" value="$(arg sqlite)"/>
  </include>

  <include file="$(find mattbot_capture)/launch/capture.launch">
    <arg name="enabled" value="$(arg capture)"/>
    <arg name="spool_dir" value="$(arg capture_spool_dir)"/>
    <arg name="ingest_ip" value="$(arg capture_ingest_ip)"/>
    <arg name="ingest_port" value="$(arg capture_ingest_port)"/>
    <arg name="pose_spool_dir" value="$(arg pose_spool_dir)"/>
    <arg name="detection_spool_dir" value="$(arg detection_spool_dir)"/>
    <arg name="tall" value="$(arg tall)"/>
  </include>

  <group if="$(arg audio)">
    <include file="$(find mattbot_record)/launch/audio_with_speech_detection.launch">
      <arg name="save_wakeword_audio" value="$(arg save_wakeword_audio)"/>
      <arg name="spool_dir" value="$(arg capture_spool_dir)"/>
    </include>
  </group>

  <group if="$(arg face_detection)">
    <include file="$(find mattbot_image_detection)/launch/face_detection.launch"/>
  </group>

</launch>
