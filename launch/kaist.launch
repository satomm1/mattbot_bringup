<!-- kaist.launch -->
<!-- Tall-robot bringup for KAIST deployment. Same stack as tall.launch with site-fixed defaults. -->
<!-- Override at launch, e.g. capture:=true audio:=true save_wakeword_audio:=true -->
<launch>

  <!-- Robot / hardware (KAIST site defaults) -->
  <arg name="tall" default="true"/>              <!-- Tall form factor: OSOD model, nav map, MCL tuning -->
  <arg name="car" default="false"/>               <!-- Car platform at KAIST (no lidar_correction include here) -->
  <arg name="front_wheel_drive" default="false"/> <!-- Car drivetrain layout passed to minimal.launch -->
  <arg name="camera_type" default="astra_pro_plus"/>  <!-- Fixed camera for KAIST (astra_pro_plus.launch) -->

  <!-- Navigation -->
  <arg name="patrol" default="false"/>           <!-- Enable patrol waypoint loop in navigator -->
  <arg name="enable_depth_occupancy_grid" default="false"/>  <!-- Camera depth occupancy grid in occupancy_grid_mapper (CPU-heavy) -->
  <arg name="enable_object_blockout" default="false"/>       <!-- Block /object_map cells when cones are confirmed -->
  <arg name="max_object_blockout_width" default="0.5"/>    <!-- Max side length (m) of each object blockout on /object_map -->
  <arg name="object_blockout_ttl_sec" default="30.0"/>     <!-- 0 = no expiry; remove expired blockouts only in IDLE -->
  <arg name="robot_clearance" default="0.35"/>    <!-- Planning radius from robot center (m); KAIST default -->
  <arg name="cruising_velocity" default="0.40"/> <!-- Nominal path speed (m/s); published as /cruising_velocity -->
  <arg name="max_plan_time_sec" default="15.0"/> <!-- Max wall-clock time (s) for A* path planning -->
  <param name="cruising_velocity" value="$(arg cruising_velocity)"/>
  <param name="enable_depth_occupancy_grid" value="$(arg enable_depth_occupancy_grid)"/>
  <param name="enable_object_blockout" value="$(arg enable_object_blockout)"/>
  <param name="max_object_blockout_width" value="$(arg max_object_blockout_width)"/>
  <param name="object_blockout_ttl_sec" value="$(arg object_blockout_ttl_sec)"/>

  <!-- Perception -->
  <arg name="use_llm_for_images" default="false"/>  <!-- Send unknown-object crops to gemini_bridge for labeling -->

  <!-- Data capture (images + optional wakeword audio upload) -->
  <arg name="capture" default="true"/>            <!-- mattbot_capture: capture_node, uploader, auto_trigger; capture:=true also enables camera IR -->
  <arg name="capture_spool_dir" default="/workspace/catkin_ws/data/capture_spool"/>  <!-- Local spool (images + audio sessions) -->
  <arg name="capture_ingest_ip" default="192.168.68.52"/>   <!-- Central ingest host for capture_uploader -->
  <arg name="capture_ingest_port" default="8080"/>         <!-- Central ingest port (/api/v1/upload) -->
  <arg name="pose_spool_dir" default="/workspace/catkin_ws/data/pose_spool"/>  <!-- Local spool for pose chunks -->
  <arg name="detection_spool_dir" default="/workspace/catkin_ws/data/detection_spool"/>  <!-- Local spool for detection snapshots -->
  <!-- Continuous capture: after /localized, record indefinitely; chunk every session_chunk_seconds -->
  <arg name="continuous_capture" default="true"/>
  <arg name="continuous_sample_hz" default="4.0"/>
  <arg name="session_chunk_seconds" default="5"/>
  <arg name="log_save_timing" default="false"/>
  <arg name="moving_sample_hz" default="10.0"/>
  <arg name="static_sample_hz" default="10"/>

  <!-- Audio (I2S mic, wakeword, Whisper, voice goals) -->
  <arg name="audio" default="false"/>              <!-- Launch mattbot_record audio_with_speech_detection -->
  <arg name="save_wakeword_audio" default="false"/>  <!-- Save post-wakeword WAVs to capture_spool_dir (needs ROBOT_ID; upload needs capture:=true) -->

  <!-- Fleet / logging -->
  <arg name="sqlite" default="false"/>             <!-- Persist DDS traffic to SQLite via mattbot_dds -->

  <!-- Experimental: object ledger + blockage belief (mattbot_dds; off by default) -->
  <arg name="ledger" default="false"/>             <!-- observation_ledger: shared ledger of confirmed objects over DDS (/ledger) -->
  <arg name="object_belief" default="$(arg ledger)"/>  <!-- object_belief_map: /object_beliefs + /object_belief_map (needs ledger) -->
  <arg name="belief_hold_s" default="60.0"/>       <!-- t1: full belief after an object's latest observation (s) -->
  <arg name="belief_decay_s" default="120.0"/>     <!-- t2: then linear decay to unknown (s) -->
  <arg name="observe" default="false"/>            <!-- Stop on the path to check objects with belief <= observe_check_below_belief (needs ledger; standard navigator only) -->
  <arg name="observe_dwell_s" default="4.0"/>      <!-- Time to hold still facing each object (s) -->
  <arg name="observe_check_below_belief" default="0.5"/>
  <arg name="observe_evaluate" default="$(arg observe)"/>  <!-- observation_evaluator: decide present / absent and update the ledger -->
  <arg name="observe_use_depth" default="true"/>   <!-- Also require the depth camera to agree before declaring an object gone -->
  <arg name="observe_min_absent_frames" default="8"/>  <!-- Clear frames needed in one window to declare an object gone -->
  <arg name="observe_importance" default="false"/>  <!-- observation_planner: value objects by obstacle importance I_o (roadmap of /map; PNG in ~/.ros/mattbot_roadmap) -->
  <arg name="observe_landmarks_file" default=""/>  <!-- YAML name: [x, y] (local map frame) trip endpoints for I_o; empty = random roadmap nodes -->
  <arg name="observe_detour" default="false"/>  <!-- Detour off the path to re-check objects no on-path stop can see, when its value of information V = N p_gone I_o beats its cost (needs ledger + observe; turns on importance) -->
  <arg name="observe_max_detour_m" default="15.0"/>  <!-- Ignore objects needing more extra driving than this (m) -->
  <arg name="observe_detour_n_trips" default="5"/>  <!-- N: fleet trips that keep avoiding an object until someone re-checks it -->
  <arg name="observe_detour_margin_m" default="0.0"/>  <!-- Detour only if V - C exceeds this (m) -->
  <arg name="ledger_blockout" default="$(arg observe_detour)"/>  <!-- occupancy_grid_mapper: plan around every ledger object until it is removed -->
  <param name="enable_ledger_blockout" value="$(arg ledger_blockout)"/>

  <arg name="package" default="mattbot_bringup"/>

  <include file="$(find mattbot_bringup)/launch/minimal.launch">
    <arg name="car" value="$(arg car)"/>
    <arg name="tall" value="$(arg tall)"/>
    <arg name="front_wheel_drive" value="$(arg front_wheel_drive)"/>
  </include>

  <include file="$(find rplidar_ros)/launch/rplidar_a2m12.launch"/>
  <include file="$(find mattbot_bringup)/launch/amcl_kaist.launch"/>

  <include file="$(find mattbot_mcl)/launch/localization_quality.launch">
    <arg name="tall" value="$(arg tall)"/>
    <!-- Looser pose-jump gates for KAIST (defaults are 0.5m / 0.5rad) -->
    <arg name="max_pose_jump_m" value="0.75"/>
    <arg name="max_pose_jump_theta" value="0.7"/>
  </include>

  <include file="$(find astra_camera)/launch/astra_pro_plus.launch">
    <arg name="enable_ir" value="$(arg capture)"/>
  </include>

  <include file="$(find mattbot_image_detection)/launch/detect_updated_osod.launch">
    <arg name="tall" value="$(arg tall)"/>
    <arg name="use_llm_for_images" value="$(arg use_llm_for_images)"/>
    <arg name="observe_evaluate" value="$(arg observe_evaluate)"/>
    <arg name="observe_use_depth" value="$(arg observe_use_depth)"/>
    <arg name="observe_min_absent_frames" value="$(arg observe_min_absent_frames)"/>
  </include>

  <include file="$(find mattbot_navigation)/launch/localize_and_navigate_combined_map_tall.launch">
    <arg name="patrol" value="$(arg patrol)"/>
    <arg name="tall" value="$(arg tall)"/>
    <arg name="car" value="$(arg car)"/>
    <arg name="robot_clearance" value="$(arg robot_clearance)"/>
    <arg name="cruising_velocity" value="$(arg cruising_velocity)"/>
    <arg name="max_plan_time_sec" value="$(arg max_plan_time_sec)"/>
    <arg name="observe" value="$(arg observe)"/>
    <arg name="observe_dwell_s" value="$(arg observe_dwell_s)"/>
    <arg name="observe_check_below_belief" value="$(arg observe_check_below_belief)"/>
    <arg name="observe_importance" value="$(arg observe_importance)"/>
    <arg name="observe_landmarks_file" value="$(arg observe_landmarks_file)"/>
    <arg name="observe_detour" value="$(arg observe_detour)"/>
    <arg name="observe_max_detour_m" value="$(arg observe_max_detour_m)"/>
    <arg name="observe_detour_n_trips" value="$(arg observe_detour_n_trips)"/>
    <arg name="observe_detour_margin_m" value="$(arg observe_detour_margin_m)"/>
  </include>

  <include file="$(find mattbot_dds)/launch/dds.launch">
    <arg name="sqlite" value="$(arg sqlite)"/>
    <arg name="tall" value="$(arg tall)"/>
    <arg name="enable_ledger" value="$(arg ledger)"/>
    <arg name="enable_object_belief" value="$(arg object_belief)"/>
    <arg name="belief_hold_s" value="$(arg belief_hold_s)"/>
    <arg name="belief_decay_s" value="$(arg belief_decay_s)"/>
  </include>

  <include file="$(find mattbot_capture)/launch/capture.launch">
    <arg name="enabled" value="$(arg capture)"/>
    <arg name="spool_dir" value="$(arg capture_spool_dir)"/>
    <arg name="ingest_ip" value="$(arg capture_ingest_ip)"/>
    <arg name="ingest_port" value="$(arg capture_ingest_port)"/>
    <arg name="pose_spool_dir" value="$(arg pose_spool_dir)"/>
    <arg name="detection_spool_dir" value="$(arg detection_spool_dir)"/>
    <arg name="tall" value="$(arg tall)"/>
    <arg name="continuous_capture" value="$(arg continuous_capture)"/>
    <arg name="continuous_sample_hz" value="$(arg continuous_sample_hz)"/>
    <arg name="session_chunk_seconds" value="$(arg session_chunk_seconds)"/>
    <arg name="log_save_timing" value="$(arg log_save_timing)"/>
    <arg name="moving_sample_hz" value="$(arg moving_sample_hz)"/>
    <arg name="static_sample_hz" value="$(arg static_sample_hz)"/>
  </include>

  <group if="$(arg audio)">
    <include file="$(find mattbot_record)/launch/audio_with_speech_detection.launch">
      <arg name="save_wakeword_audio" value="$(arg save_wakeword_audio)"/>
      <arg name="spool_dir" value="$(arg capture_spool_dir)"/>
    </include>
  </group>

</launch>
