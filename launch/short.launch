<!-- short.launch -->
<launch>

  <arg name="tall" default="false"/>
  <arg name="patrol" default="false"/>
  <arg name="camera_type" default="$(env CAMERA_TYPE)"/>

  <!-- Specify the package name -->
  <arg name="package" default="mattbot_bringup"/>

  <!-- Define car argument with default as false -->
  <arg name="car" default="false"/>
  <arg name="sqlite" default="false"/>  

  <!-- Set the use_social_astar parameter based on the social argument -->
  <arg name="social" default="false"/>

  <!-- Use multi-agent navigator (external_goal_multi, DDS planned-path handoff) instead of localize_and_navigate2 -->
  <arg name="multi_agent_nav" default="false"/>

  <include file="$(find mattbot_bringup)/launch/minimal.launch">
    <arg name="car" value="$(arg car)"/>
    <arg name="tall" value="$(arg tall)"/>
  </include>
  
  <!-- Conditionally launch LiDAR Correction based on car parameter -->
  <group if="$(arg car)">
    <!-- Launch the LIDAR -->
    <include file="$(find rplidar_ros)/launch/rplidar_a2m12.launch">
      <arg name="scan_topic" value="scan_original"/>
    </include>

    <!-- Launch LiDAR Correction with inclined compensation -->
    <include file="$(find mattbot_mcl)/launch/lidar_correction.launch">
      <arg name="scan_input" value="/scan_original"/>
      <arg name="scan_output" value="/scan"/>  
    </include>

    <!-- Launch AMCL for the car -->
    <include file="$(find mattbot_bringup)/launch/amcl_car.launch">
      <!-- No arguments needed -->
    </include>
  </group>
  
  <group unless="$(arg car)">
    <!-- Launch the LIDAR without inclined correction -->
    <include file="$(find rplidar_ros)/launch/rplidar_a2m12.launch">

    </include>

    <!-- Launch AMCL for the robot -->
    <include file="$(find mattbot_bringup)/launch/amcl.launch">
      <!-- No arguments needed -->
    </include>
  </group>

  <include file="$(find mattbot_mcl)/launch/localization_quality.launch">
    <arg name="tall" value="$(arg tall)"/>
    <!-- No arguments needed -->
  </include>

  <!-- Launch the Camera node -->
  <group if="$(eval arg('camera_type') == 'astra_pro_plus')">
    <!-- Launch the astra pro plus camera-->
    <include file="$(find astra_camera)/launch/astra_pro_plus.launch">
      <!-- No arguments needed -->
    </include>
  </group>

  <group unless="$(eval arg('camera_type') == 'astra_pro_plus')">
    <!-- If not astra_pro_plus, default to astra -->
    <include file="$(find astra_camera)/launch/astra.launch">
      <!-- No arguments needed -->
    </include>
  </group>

  <!-- Launch the OSOD node -->
  <include file="$(find mattbot_image_detection)/launch/detect_updated_osod.launch">
    <arg name="tall" default="$(arg tall)"/>
  </include> 

  <!-- Localization and navigation: default v2, or multi-agent variant when multi_agent_nav is true -->
  <group unless="$(arg multi_agent_nav)">
    <include file="$(find mattbot_navigation)/launch/localize_and_navigate_combined_map_short.launch">
      <arg name="social" value="$(arg social)"/>
    </include>
  </group>
  <group if="$(arg multi_agent_nav)">
    <include file="$(find mattbot_navigation)/launch/localize_and_navigate_multi_agent_short.launch">
      <arg name="social" value="$(arg social)"/>
      <arg name="patrol" value="$(arg patrol)"/>
    </include>
  </group>

  <!-- Launch the DDS (wireless communications) node -->
  <include file="$(find mattbot_dds)/launch/dds.launch">
    <arg name="sqlite" value="$(arg sqlite)"/>
  </include>

</launch>
